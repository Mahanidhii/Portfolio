# SMTP Configuration
# Get these from your email provider (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Destination email (where contact submissions arrive)
CONTACT_DEST=mahanidhi.gk@gmail.com

# Server
PORT=5000

# CORS — set to your production domain when deploying
CLIENT_URL=http://localhost:5173
